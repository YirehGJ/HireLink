rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Documento de usuario del que hace la petición (Firestore lo cachea por petición).
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRole(role) {
      return me().role == role;
    }

    // Las cuentas suspendidas por un admin no pueden leer ni escribir nada, salvo su propio documento de usuario
    // (la pantalla lo necesita para avisarles que están suspendidas).
    function isActive() {
      return me().get('status', 'active') != 'suspended';
    }

    // Administradora activa: una cuenta de admin suspendida pierde sus poderes.
    function isAdmin() {
      return isRole('admin') && isActive();
    }

    // Una reclutadora solo ve candidatas y publica vacantes cuando un administrador la aprobó
    // (`recruiterApproved`, que solo escribe el servidor).
    function isApproved() {
      return me().get('recruiterApproved', false) == true;
    }

    // Reclutadora activa de la organización dada. Cuenta el rol y no solo la empresa: quien cambió de rol deja
    // de contar aunque conserve su organizationRef.
    function isRecruiterForOrg(orgId) {
      return isRole('recruiter') && isActive() && orgId != '' && me().get('organizationRef', '') == orgId;
    }

    // Reclutadora activa Y aprobada de la organización dada: puede publicar y gestionar.
    function isActiveRecruiterOf(orgId) {
      return isRecruiterForOrg(orgId) && isApproved();
    }

    // Reclutadora activa y aprobada, de cualquier empresa: es la única que ve los perfiles de las candidatas.
    function isApprovedRecruiter() {
      return isRole('recruiter') && isActive() && isApproved();
    }

    // Campos que cambia la escritura en curso (solo para `update`).
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------------------------------------------------------------
    // Validaciones de tamaño/forma (evitan documentos gigantes y campos inventados)
    // ---------------------------------------------------------------
    function validCandidate(d, candidateId) {
      return d.get('headline', '') is string && d.get('headline', '').size() <= 200
        && d.get('location', '') is string && d.get('location', '').size() <= 200
        && d.get('fullName', '') is string && d.get('fullName', '').size() <= 120
        && d.get('email', '') is string && d.get('email', '').size() <= 200
        && d.get('skills', []) is list && d.get('skills', []).size() <= 60
        && d.get('experience', []) is list && d.get('experience', []).size() <= 20
        && d.get('education', []) is list && d.get('education', []).size() <= 15
        && d.get('cvSummary', '') is string && d.get('cvSummary', '').size() <= 2500
        && d.get('cvText', '') is string && d.get('cvText', '').size() <= 9000
        && d.get('targetSeniority', '') in ['', 'intern', 'junior', 'mid', 'senior', 'lead']
        && d.get('userRef', candidateId) == candidateId;
    }

    function validJob(d) {
      return d.title is string && d.title.size() <= 200
        && d.descriptionMd is string && d.descriptionMd.size() <= 10000
        && d.get('location', '').size() <= 200
        && d.get('searchTags', []) is list && d.get('searchTags', []).size() <= 40
        && d.status in ['published', 'draft', 'closed'];
    }

    function validOrg(d) {
      return d.name is string && d.name.size() <= 200
        && d.get('website', '').size() <= 300
        && d.get('description', '').size() <= 3000
        && d.get('logoUrl', '').size() <= 500;
    }

    // ---------------------------------------------------------------
    // USERS
    // ---------------------------------------------------------------
    match /users/{userId} {
      // Alta propia: nunca como admin, sin organización preasignada, sin aprobación y siempre activo.
      allow create: if isSignedIn() && isOwner(userId)
        && request.resource.data.role in ['candidate', 'recruiter']
        && request.resource.data.status == 'active'
        && request.resource.data.keys().hasOnly(['id', 'email', 'fullName', 'role', 'status', 'phone'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() <= 120;

      // La persona ve su propio documento aunque esté suspendida; las admins ven todos.
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());

      // El dueño solo puede cambiar nombre y teléfono; puede enlazar UNA organización únicamente si es
      // reclutador, aún no tiene una y él mismo la creó (ownerUid). Rol, estado, aprobación, correo e id
      // solo los cambia el servidor (/api/admin/users) con el SDK de administración, que además deja
      // constancia en la auditoría: ningún cliente puede escribirlos.
      allow update: if isSignedIn() && isOwner(userId) && isActive()
        && changedKeys().hasOnly(['fullName', 'phone', 'organizationRef'])
        && (!('fullName' in changedKeys())
            || (request.resource.data.fullName is string && request.resource.data.fullName.size() <= 120))
        && (!('phone' in changedKeys())
            || (request.resource.data.phone is string && request.resource.data.phone.size() <= 40))
        && (!('organizationRef' in changedKeys())
            || (
              resource.data.role == 'recruiter'
              && !('organizationRef' in resource.data)
              && get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationRef)).data.get('ownerUid', '') == request.auth.uid
            ));

      // Eliminar cuentas (con todo lo que depende de ellas) lo hace el servidor.
      allow delete: if false;
      allow list: if isSignedIn() && isAdmin();

      // Preferencias del usuario
      match /settings/{settingId} {
        allow read: if isSignedIn() && isOwner(userId) && isActive();
        allow write: if isSignedIn() && isOwner(userId) && isActive();
      }

      // Notificaciones: las crea solo el servidor; el dueño solo marca `read`.
      match /notifications/{notifId} {
        allow get, list: if isSignedIn() && isOwner(userId) && isActive();
        allow update: if isSignedIn() && isOwner(userId) && isActive() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }

      // Copia por candidato de sus postulaciones (lectura en tiempo real sin índices).
      // Se crea al postular (siempre "applied"); los cambios de estado los hace el servidor.
      match /applications/{jobId} {
        allow get, list: if isSignedIn() && ((isOwner(userId) && isActive()) || isAdmin());
        allow create: if isSignedIn() && isOwner(userId) && isActive()
          && request.resource.data.candidateRef == userId
          && request.resource.data.jobRef == jobId
          && request.resource.data.status == 'applied'
          && request.resource.data.keys().hasOnly(['candidateRef', 'jobRef', 'status', 'source', 'cvRef', 'appliedAt', 'updatedAt']);
        allow update, delete: if false;
      }
    }

    // ---------------------------------------------------------------
    // CANDIDATES
    // ---------------------------------------------------------------
    match /candidates/{candidateId} {
        allow create: if isSignedIn() && isOwner(candidateId) && isActive()
          && validCandidate(request.resource.data, candidateId);
        // Solo reclutadoras aprobadas y admins ven perfiles; la candidata ve el suyo.
        allow get: if isSignedIn() && ((isOwner(candidateId) && isActive()) || isAdmin() || isApprovedRecruiter());
        allow update: if isSignedIn() && isOwner(candidateId) && isActive()
          && validCandidate(request.resource.data, candidateId);
        // Borrar un perfil lo hace el servidor junto con el resto de la cuenta.
        allow delete: if false;
        allow list: if isSignedIn() && (isAdmin() || isApprovedRecruiter());

        match /skills/{skillId} {
            allow read: if isSignedIn() && isOwner(candidateId) && isActive();
            allow write: if isSignedIn() && isOwner(candidateId) && isActive();
        }
    }

    // ---------------------------------------------------------------
    // ORGANIZATIONS
    // ---------------------------------------------------------------
    match /organizations/{orgId} {
      allow get, list: if isSignedIn() && isActive();
      // Una reclutadora sin organización puede crear la suya (queda como ownerUid), aunque aún no esté
      // aprobada: así completa su empresa mientras espera. Los admins pueden crear cualquiera.
      allow create: if isSignedIn() && validOrg(request.resource.data) && (
        isAdmin() ||
        (isRole('recruiter') && isActive()
          && !('organizationRef' in me())
          && request.resource.data.get('ownerUid', '') == request.auth.uid)
      );
      allow update: if isSignedIn() && validOrg(request.resource.data) && (
        isAdmin() ||
        (isRecruiterForOrg(orgId)
          && request.resource.data.get('ownerUid', '') == resource.data.get('ownerUid', ''))
      );
      allow delete: if isSignedIn() && isAdmin();
    }

    // ---------------------------------------------------------------
    // JOBS
    // ---------------------------------------------------------------
    match /jobs/{jobId} {
      // Las candidatas solo ven vacantes publicadas o cerradas; los borradores son
      // solo de su organización y de los admins.
      allow get, list: if isSignedIn() && isActive() && (
        resource.data.status in ['published', 'closed'] ||
        isAdmin() ||
        isRecruiterForOrg(resource.data.organizationRef)
      );
      allow create: if isSignedIn() && isActiveRecruiterOf(request.resource.data.organizationRef)
        && validJob(request.resource.data);
      allow update: if isSignedIn() && validJob(request.resource.data) && (
        isAdmin() ||
        (isActiveRecruiterOf(resource.data.organizationRef)
          && request.resource.data.organizationRef == resource.data.organizationRef)
      );
      allow delete: if isSignedIn() && (isAdmin() || isActiveRecruiterOf(resource.data.organizationRef));

        // Postulaciones
        match /applications/{appId} {
            // La candidata solo puede postularse ella misma, una vez, a una vacante
            // publicada y siempre en estado "applied".
            allow create: if isSignedIn() && isActive()
              && request.auth.uid == request.resource.data.candidateRef
              && appId == request.auth.uid
              && request.resource.data.jobRef == jobId
              && request.resource.data.status == 'applied'
              && get(/databases/$(database)/documents/jobs/$(jobId)).data.status == 'published'
              && request.resource.data.keys().hasOnly(['candidateRef', 'jobRef', 'status', 'source', 'cvRef', 'appliedAt', 'updatedAt']);
            // La candidata ve la suya; la empresa de la vacante y los admins ven todas. Las notas privadas de la
            // reclutadora NO viven aquí (ver `applicantNotes`): este documento lo lee la propia candidata.
            allow get, list: if isSignedIn() && isActive() && (
                isOwner(resource.data.candidateRef) ||
                isAdmin() ||
                isRecruiterForOrg(get(/databases/$(database)/documents/jobs/$(jobId)).data.organizationRef)
            );
            // Las reclutadoras aprobadas de la empresa solo cambian el estado, y nunca a «retirado» ni sobre una
            // postulación que la candidata ya retiró.
            allow update: if isSignedIn()
              && isActiveRecruiterOf(get(/databases/$(database)/documents/jobs/$(jobId)).data.organizationRef)
              && changedKeys().hasOnly(['status', 'updatedAt'])
              && request.resource.data.status in ['applied', 'screening', 'assessment', 'interview', 'offer', 'hired', 'rejected']
              && resource.data.status != 'withdrawn';
            // La candidata puede retirar su postulación.
            allow delete: if isSignedIn() && isActive() && isOwner(resource.data.candidateRef);
        }

        // Notas privadas y shortlist de la reclutadora sobre cada postulante (mismo id que la postulación).
        // Solo las lee y escribe la empresa de la vacante (y las admins leen): la candidata no tiene acceso.
        match /applicantNotes/{noteId} {
            allow get, list: if isSignedIn() && (
                isAdmin() ||
                isActiveRecruiterOf(get(/databases/$(database)/documents/jobs/$(jobId)).data.organizationRef)
            );
            allow create, update: if isSignedIn()
              && isActiveRecruiterOf(get(/databases/$(database)/documents/jobs/$(jobId)).data.organizationRef)
              && request.resource.data.keys().hasOnly(['shortlisted', 'recruiterNotes', 'updatedAt'])
              && request.resource.data.get('shortlisted', false) is bool
              && request.resource.data.get('recruiterNotes', '') is string
              && request.resource.data.get('recruiterNotes', '').size() <= 5000;
            allow delete: if false;
        }
    }

    // Postulaciones (collection group): métricas globales del admin y consultas de la reclutadora.
    match /{path=**}/applications/{appId} {
      allow get, list: if isSignedIn() && isActive() && (
        isAdmin() ||
        (resource.data.keys().hasAny(['jobRef']) &&
          isRecruiterForOrg(get(/databases/$(database)/documents/jobs/$(resource.data.jobRef)).data.organizationRef))
      );
    }

    // ---------------------------------------------------------------
    // INTERVIEWS
    // ---------------------------------------------------------------
    match /interviews/{interviewId} {
      allow get, list: if isSignedIn() && isActive() && (
        isOwner(resource.data.candidateRef) ||
        isAdmin() ||
        isRecruiterForOrg(resource.data.organizationRef)
      );
      // Solo para una persona que se postuló a una vacante de la propia empresa (antes se podía agendar con
      // cualquier cuenta y el aviso llegaba a quien fuera).
      allow create: if isSignedIn() && isActiveRecruiterOf(request.resource.data.organizationRef)
        && request.resource.data.get('location', '').size() <= 500
        && request.resource.data.interviewerRef == request.auth.uid
        && request.resource.data.type in ['phone', 'video', 'onsite']
        && request.resource.data.scheduledStart is timestamp
        && request.resource.data.jobRef is string
        && request.resource.data.candidateRef is string
        && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobRef)).data.organizationRef == request.resource.data.organizationRef
        && exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobRef)/applications/$(request.resource.data.candidateRef));
      // No se puede cambiar a quién ni de qué vacante es una entrevista.
      allow update: if isSignedIn() && isActiveRecruiterOf(resource.data.organizationRef)
        && changedKeys().hasOnly(['scheduledStart', 'location', 'notes', 'type'])
        && request.resource.data.get('location', '').size() <= 500;
      allow delete: if isSignedIn() && isActiveRecruiterOf(resource.data.organizationRef);
    }

    // ---------------------------------------------------------------
    // RECOMMENDATIONS (matches de la IA): solo el servidor escribe
    // ---------------------------------------------------------------
    match /recommendations/{recId} {
      allow get, list: if isSignedIn() && isActive() && (
        request.auth.uid == resource.data.candidateRef ||
        isAdmin() ||
        isRecruiterForOrg(get(/databases/$(database)/documents/jobs/$(resource.data.jobRef)).data.organizationRef)
      );
      allow create, update, delete: if false;
    }

    // ---------------------------------------------------------------
    // AUDIT LOGS: escritos solo por el servidor; lectura solo admin
    // ---------------------------------------------------------------
    match /auditLogs/{logId} {
      allow get, list: if isSignedIn() && isAdmin();
      allow create, update, delete: if false;
    }

    // Rate limits (uso interno del servidor): cerrado a los clientes.
    match /rateLimits/{docId} {
      allow read, write: if false;
    }
  }
}
