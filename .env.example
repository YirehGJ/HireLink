# Copia este archivo a `.env.local` (desarrollo) o a `.env.staging` y completa los valores.
# Nunca subas el archivo con valores reales a Git: `.env*` está en .gitignore.
# Guía completa: docs/ENTORNOS.md

# ---------------------------------------------------------------- Firebase (cliente, públicas)
# Firebase Console > Project settings > General > Your apps (aplicación web)
NEXT_PUBLIC_FB_API_KEY=
NEXT_PUBLIC_FB_AUTH_DOMAIN=
NEXT_PUBLIC_FB_PROJECT_ID=
NEXT_PUBLIC_FB_STORAGE_BUCKET=
NEXT_PUBLIC_FB_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FB_APP_ID=
NEXT_PUBLIC_FB_MEASUREMENT_ID=

# ---------------------------------------------------------------- Firebase Admin (servidor, SECRETAS)
# Firebase Console > Project settings > Service accounts > Generate new private key.
# La clave privada va en UNA línea, con los saltos de línea escritos como \n
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------- IA (servidor, SECRETA)
# https://console.groq.com > API Keys. Debe empezar con gsk_ y no llevar espacios ni saltos de línea.
GROQ_API_KEY=
# Opcional. Modelo principal de Groq; si se deja vacío se usa openai/gpt-oss-120b. En el plan gratuito cada modelo
# tiene su propio cupo diario (200 000 tokens): cuando el principal se agota, la aplicación pasa sola al de respaldo.
GROQ_MODEL_ID=
# Opcional. Modelo de respaldo; si se deja vacío se usa openai/gpt-oss-20b.
GROQ_FALLBACK_MODEL_ID=

# ---------------------------------------------------------------- Opcionales
# Botón «Google» en el inicio de sesión: apagado salvo que valga true (siempre crea cuentas de candidata y no se
# probó en celulares con Safari). Se lee al compilar: hay que volver a desplegar al cambiarlo.
NEXT_PUBLIC_GOOGLE_LOGIN=

# Correo (docs/EMAIL_SETUP.md)
RESEND_API_KEY=
EMAIL_FROM=
NEXT_PUBLIC_APP_URL=

# Seguimiento de errores (docs/SENTRY_SETUP.md)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
